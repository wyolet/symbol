{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uvx --from wyolet-symbol==0.2.5 symbol hook"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uvx --from wyolet-symbol==0.2.5 symbol hook"
          }
        ]
      }
    ]
  }
}
